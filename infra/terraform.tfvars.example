# Copy this to terraform.tfvars and fill in your real values.
# terraform.tfvars is gitignored — never commit real secrets.

git_repo_url      = "https://github.com/your-username/job-search-copilot.git"
anthropic_api_key = "sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional overrides:
# aws_region       = "us-east-1"
# instance_type    = "t3.small"
# allowed_ssh_cidr = "1.2.3.4/32"   # your real IP — much safer than 0.0.0.0/0
